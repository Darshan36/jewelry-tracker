// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (Prisma 7 architecture).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASE_DEPT
  LABOUR_MGMT
  CASTING_PLATING_MGMT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  // Phase 16: soft-delete (= deactivation) matching the app-wide
  // convention. `deletedAt IS NOT NULL` means the user is deactivated:
  // can't log in (auth/authorize rejects), still queryable via listUsers
  // so they appear in the management UI with an "Inactive" chip, and
  // their audit-trail FKs (createdById/updatedById/deletedById on every
  // entity) stay intact.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedAttachments Attachment[]
  partiesCreated      Party[]      @relation("PartyCreatedBy")
  partiesUpdated      Party[]      @relation("PartyUpdatedBy")
  partiesDeleted      Party[]      @relation("PartyDeletedBy")

  pieceEntriesCreated     PieceEntry[]      @relation("PieceEntryCreatedBy")
  pieceEntriesUpdated     PieceEntry[]      @relation("PieceEntryUpdatedBy")
  pieceEntriesDeleted     PieceEntry[]      @relation("PieceEntryDeletedBy")
  employeePaymentsCreated EmployeePayment[] @relation("EmployeePaymentCreatedBy")
  employeePaymentsUpdated EmployeePayment[] @relation("EmployeePaymentUpdatedBy")
  employeePaymentsDeleted EmployeePayment[] @relation("EmployeePaymentDeletedBy")

  @@map("users")
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
}

// Polymorphic attachment table — stores both invoice bills and visual
// photos. The discriminator (attachedToType + attachedToId) determines
// which parent entity owns the attachment. See CLAUDE.md §4 for the full
// rationale and KNOWN_GAPS for the Phase-12a discriminator-vs-FK lineage.
// User-facing UI continues to call these "bills" — the rename only
// affects the internal data layer.
model Attachment {
  id               String           @id @default(cuid())
  r2Key            String           @unique
  mimeType         String
  sizeBytes        Int
  originalFilename String
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  attachedToType   String?
  attachedToId     String?
  status           AttachmentStatus @default(PENDING)
  uploadedAt       DateTime         @default(now())
  confirmedAt      DateTime?
  deletedAt        DateTime?

  castingEntry CastingEntry?
  platingEntry PlatingEntry?

  @@index([uploadedById])
  @@index([attachedToType, attachedToId])
  @@index([deletedAt])
  @@index([status])
  @@map("attachments")
}

// Unified party model — replaces Customer / Supplier / CastingPlatingVendor
// (Phase 17a). Role flags determine which UI surfaces show the party. A
// single party can have multiple roles set (e.g. a regular who both sells
// to and buys from the shop). Phone is globally unique across all roles.
// Walk-in auto-promotion implicitly sets the role flag from form context.
model Party {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  email           String?
  address         String?
  notes           String?
  isCustomer      Boolean   @default(false)
  isSupplier      Boolean   @default(false)
  isCastingVendor Boolean   @default(false)
  isPlatingVendor Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  deletedById     String?

  createdBy User? @relation("PartyCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PartyUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PartyDeletedBy", fields: [deletedById], references: [id])

  sales          Sale[]
  purchases      Purchase[]
  castingEntries CastingEntry[]
  platingEntries PlatingEntry[]

  @@index([phone])
  @@index([name])
  @@index([isCustomer, deletedAt])
  @@index([isSupplier, deletedAt])
  @@index([isCastingVendor, deletedAt])
  @@index([isPlatingVendor, deletedAt])
  @@map("parties")
}

enum EmployeeType {
  FIXED
  LABOUR
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  type          EmployeeType @default(LABOUR)
  monthlySalary BigInt?
  address       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  pieceEntries PieceEntry[]
  payments     EmployeePayment[]

  @@index([deletedAt])
  @@index([name])
  @@index([type])
  @@map("employees")
}

// Phase 18 — piece-rate ledger entry for LABOUR employees.
// One row = one employee × one day × one piece count. `totalAmount` is
// stored (= count × ratePerPiece) for query-side aggregate efficiency.
// Daily bulk entry is the dominant workflow; per-employee ad-hoc entry
// is allowed via the detail modal.
model PieceEntry {
  id           String   @id @default(cuid())
  employeeId   String
  // Stored as midnight UTC representing the IST calendar day, matching
  // the Sale/Purchase/CastingEntry convention so the same UTC-range
  // queries work for monthly aggregates.
  date         DateTime
  count        Int
  ratePerPiece BigInt // paise per piece, entered per piece-entry (rate varies by job, not by worker)
  totalAmount  BigInt // paise, stored: count * ratePerPiece
  note         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  deletedById String?

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User?    @relation("PieceEntryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("PieceEntryUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User?    @relation("PieceEntryDeletedBy", fields: [deletedById], references: [id])

  @@index([employeeId, date, deletedAt])
  @@index([date, deletedAt])
  @@map("piece_entries")
}

// Phase 18 — unified employee payment ledger.
// type=SALARY: monthly payment for a FIXED employee, periodStart/periodEnd
//   are the calendar-month boundaries (midnight-UTC representing IST).
// type=WAGE: per-period payment for a LABOUR employee covering a range
//   of PieceEntries. Coverage is determined by period overlap, NOT by a
//   per-entry paid flag — keeps production tracking decoupled from
//   payment tracking and allows ad-hoc payment periods.
enum EmployeePaymentType {
  SALARY
  WAGE
}

model EmployeePayment {
  id          String              @id @default(cuid())
  employeeId  String
  type        EmployeePaymentType
  paidAt      DateTime // when the payment was actually made
  amount      BigInt // paise
  periodStart DateTime // inclusive
  periodEnd   DateTime // inclusive
  note        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  deletedById String?

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User?    @relation("EmployeePaymentCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("EmployeePaymentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User?    @relation("EmployeePaymentDeletedBy", fields: [deletedById], references: [id])

  @@index([employeeId, periodStart, periodEnd, deletedAt])
  @@index([type, periodStart, deletedAt])
  @@index([deletedAt])
  @@map("employee_payments")
}

model Sale {
  id         String    @id @default(cuid())
  date       DateTime
  partyId    String?
  party      Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt    @default(0)
  total      BigInt
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  payments  SalePayment[]
  returns   SaleReturn[]
  lineItems SaleLineItem[]

  @@index([deletedAt])
  @@index([date])
  @@index([partyId])
  @@map("sales")
}

model SaleLineItem {
  id              String   @id @default(cuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemDescription String
  qty             Int
  rate            BigInt
  createdAt       DateTime @default(now())

  @@index([saleId])
  @@map("sale_line_items")
}

enum PaymentType {
  PAYMENT
  REFUND
}

model SalePayment {
  id        String      @id @default(cuid())
  saleId    String
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    BigInt
  type      PaymentType @default(PAYMENT)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([saleId])
  @@index([saleId, type])
  @@index([deletedAt])
  @@map("sale_payments")
}

model SaleReturn {
  id           String    @id @default(cuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([saleId])
  @@index([deletedAt])
  @@map("sale_returns")
}

model Purchase {
  id         String    @id @default(cuid())
  date       DateTime
  partyId    String?
  party      Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt    @default(0)
  total      BigInt
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  payments  PurchasePayment[]
  returns   PurchaseReturn[]
  lineItems PurchaseLineItem[]

  @@index([deletedAt])
  @@index([date])
  @@index([partyId])
  @@map("purchases")
}

model PurchaseLineItem {
  id              String   @id @default(cuid())
  purchaseId      String
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemDescription String
  qty             Int
  rate            BigInt
  createdAt       DateTime @default(now())

  @@index([purchaseId])
  @@map("purchase_line_items")
}

model PurchasePayment {
  id         String      @id @default(cuid())
  purchaseId String
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     BigInt
  type       PaymentType @default(PAYMENT)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([purchaseId])
  @@index([purchaseId, type])
  @@index([deletedAt])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id           String    @id @default(cuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([purchaseId])
  @@index([deletedAt])
  @@map("purchase_returns")
}

model CastingEntry {
  id           String      @id @default(cuid())
  date         DateTime
  partyId      String?
  party        Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName    String
  partyPhone   String?
  discount     BigInt      @default(0)
  total        BigInt
  notes        String?
  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  lineItems CastingLineItem[]
  payments  CastingPayment[]

  @@index([partyId])
  @@index([deletedAt])
  @@index([date])
  @@map("casting_entries")
}

model CastingLineItem {
  id                  String       @id @default(cuid())
  castingEntryId      String
  castingEntry        CastingEntry @relation(fields: [castingEntryId], references: [id], onDelete: Cascade)
  materialDescription String
  weightKg            Decimal      @db.Decimal(10, 3)
  ratePerKg           BigInt
  lineTotal           BigInt
  createdAt           DateTime     @default(now())

  @@index([castingEntryId])
  @@map("casting_line_items")
}

model CastingPayment {
  id             String       @id @default(cuid())
  castingEntryId String
  castingEntry   CastingEntry @relation(fields: [castingEntryId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         BigInt
  type           PaymentType  @default(PAYMENT)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([castingEntryId])
  @@index([castingEntryId, type])
  @@index([deletedAt])
  @@map("casting_payments")
}

model PlatingEntry {
  id           String      @id @default(cuid())
  date         DateTime
  partyId      String?
  party        Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName    String
  partyPhone   String?
  discount     BigInt      @default(0)
  total        BigInt
  notes        String?
  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  lineItems PlatingLineItem[]
  payments  PlatingPayment[]

  @@index([partyId])
  @@index([deletedAt])
  @@index([date])
  @@map("plating_entries")
}

model PlatingLineItem {
  id                  String       @id @default(cuid())
  platingEntryId      String
  platingEntry        PlatingEntry @relation(fields: [platingEntryId], references: [id], onDelete: Cascade)
  materialDescription String
  weightKg            Decimal      @db.Decimal(10, 3)
  ratePerKg           BigInt
  lineTotal           BigInt
  createdAt           DateTime     @default(now())

  @@index([platingEntryId])
  @@map("plating_line_items")
}

model PlatingPayment {
  id             String       @id @default(cuid())
  platingEntryId String
  platingEntry   PlatingEntry @relation(fields: [platingEntryId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         BigInt
  type           PaymentType  @default(PAYMENT)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([platingEntryId])
  @@index([platingEntryId, type])
  @@index([deletedAt])
  @@map("plating_payments")
}
