// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (Prisma 7 architecture).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASE_DEPT
  LABOUR_MGMT
  CASTING_PLATING_MGMT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedAttachments Attachment[]

  @@map("users")
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
}

// Polymorphic attachment table — stores both invoice bills and visual
// photos. The discriminator (attachedToType + attachedToId) determines
// which parent entity owns the attachment. See CLAUDE.md §4 for the full
// rationale and KNOWN_GAPS for the Phase-12a discriminator-vs-FK lineage.
// User-facing UI continues to call these "bills" — the rename only
// affects the internal data layer.
model Attachment {
  id               String           @id @default(cuid())
  r2Key            String           @unique
  mimeType         String
  sizeBytes        Int
  originalFilename String
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  attachedToType   String?
  attachedToId     String?
  status           AttachmentStatus @default(PENDING)
  uploadedAt       DateTime         @default(now())
  confirmedAt      DateTime?
  deletedAt        DateTime?

  castingEntry CastingEntry?
  platingEntry PlatingEntry?

  @@index([uploadedById])
  @@index([attachedToType, attachedToId])
  @@index([deletedAt])
  @@index([status])
  @@map("attachments")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales Sale[]

  @@index([deletedAt])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchases Purchase[]

  @@index([deletedAt])
  @@index([name])
  @@map("suppliers")
}

enum EmployeeType {
  FIXED
  LABOUR
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  type          EmployeeType @default(LABOUR)
  monthlySalary BigInt?
  address       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@index([name])
  @@index([type])
  @@map("employees")
}

model Sale {
  id         String    @id @default(cuid())
  date       DateTime
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt    @default(0)
  total      BigInt
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  payments  SalePayment[]
  returns   SaleReturn[]
  lineItems SaleLineItem[]

  @@index([deletedAt])
  @@index([date])
  @@index([customerId])
  @@map("sales")
}

model SaleLineItem {
  id              String   @id @default(cuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemDescription String
  qty             Int
  rate            BigInt
  createdAt       DateTime @default(now())

  @@index([saleId])
  @@map("sale_line_items")
}

enum PaymentType {
  PAYMENT
  REFUND
}

model SalePayment {
  id        String      @id @default(cuid())
  saleId    String
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    BigInt
  type      PaymentType @default(PAYMENT)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([saleId])
  @@index([saleId, type])
  @@index([deletedAt])
  @@map("sale_payments")
}

model SaleReturn {
  id           String    @id @default(cuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([saleId])
  @@index([deletedAt])
  @@map("sale_returns")
}

model Purchase {
  id         String    @id @default(cuid())
  date       DateTime
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt    @default(0)
  total      BigInt
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  payments  PurchasePayment[]
  returns   PurchaseReturn[]
  lineItems PurchaseLineItem[]

  @@index([deletedAt])
  @@index([date])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseLineItem {
  id              String   @id @default(cuid())
  purchaseId      String
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemDescription String
  qty             Int
  rate            BigInt
  createdAt       DateTime @default(now())

  @@index([purchaseId])
  @@map("purchase_line_items")
}

model PurchasePayment {
  id         String      @id @default(cuid())
  purchaseId String
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     BigInt
  type       PaymentType @default(PAYMENT)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([purchaseId])
  @@index([purchaseId, type])
  @@index([deletedAt])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id           String    @id @default(cuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([purchaseId])
  @@index([deletedAt])
  @@map("purchase_returns")
}

model CastingPlatingVendor {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  castingEntries CastingEntry[]
  platingEntries PlatingEntry[]

  @@index([phone])
  @@index([deletedAt])
  @@index([name])
  @@map("casting_plating_vendors")
}

model CastingEntry {
  id         String                @id @default(cuid())
  date       DateTime
  vendorId   String?
  vendor     CastingPlatingVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt                @default(0)
  total      BigInt
  notes      String?
  attachmentId String?              @unique
  attachment   Attachment?           @relation(fields: [attachmentId], references: [id])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  deletedAt  DateTime?

  lineItems CastingLineItem[]
  payments  CastingPayment[]

  @@index([vendorId])
  @@index([deletedAt])
  @@index([date])
  @@map("casting_entries")
}

model CastingLineItem {
  id                  String       @id @default(cuid())
  castingEntryId      String
  castingEntry        CastingEntry @relation(fields: [castingEntryId], references: [id], onDelete: Cascade)
  materialDescription String
  weightKg            Decimal      @db.Decimal(10, 3)
  ratePerKg           BigInt
  lineTotal           BigInt
  createdAt           DateTime     @default(now())

  @@index([castingEntryId])
  @@map("casting_line_items")
}

model CastingPayment {
  id             String       @id @default(cuid())
  castingEntryId String
  castingEntry   CastingEntry @relation(fields: [castingEntryId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         BigInt
  type           PaymentType  @default(PAYMENT)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([castingEntryId])
  @@index([castingEntryId, type])
  @@index([deletedAt])
  @@map("casting_payments")
}

model PlatingEntry {
  id         String                @id @default(cuid())
  date       DateTime
  vendorId   String?
  vendor     CastingPlatingVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partyName  String
  partyPhone String?
  discount   BigInt                @default(0)
  total      BigInt
  notes      String?
  attachmentId String?              @unique
  attachment   Attachment?           @relation(fields: [attachmentId], references: [id])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  deletedAt  DateTime?

  lineItems PlatingLineItem[]
  payments  PlatingPayment[]

  @@index([vendorId])
  @@index([deletedAt])
  @@index([date])
  @@map("plating_entries")
}

model PlatingLineItem {
  id                  String       @id @default(cuid())
  platingEntryId      String
  platingEntry        PlatingEntry @relation(fields: [platingEntryId], references: [id], onDelete: Cascade)
  materialDescription String
  weightKg            Decimal      @db.Decimal(10, 3)
  ratePerKg           BigInt
  lineTotal           BigInt
  createdAt           DateTime     @default(now())

  @@index([platingEntryId])
  @@map("plating_line_items")
}

model PlatingPayment {
  id             String       @id @default(cuid())
  platingEntryId String
  platingEntry   PlatingEntry @relation(fields: [platingEntryId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         BigInt
  type           PaymentType  @default(PAYMENT)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([platingEntryId])
  @@index([platingEntryId, type])
  @@index([deletedAt])
  @@map("plating_payments")
}
