// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (Prisma 7 architecture).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASE_DEPT
  LABOUR_MGMT
  CASTING_PLATING_MGMT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales Sale[]

  @@index([deletedAt])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchases Purchase[]

  @@index([deletedAt])
  @@index([name])
  @@map("suppliers")
}

enum EmployeeType {
  FIXED
  LABOUR
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  type          EmployeeType @default(LABOUR)
  monthlySalary BigInt?
  address       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@index([name])
  @@index([type])
  @@map("employees")
}

model Sale {
  id              String    @id @default(cuid())
  date            DateTime
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partyName       String
  partyPhone      String?
  itemDescription String
  qty             Int
  rate            BigInt
  discount        BigInt    @default(0)
  total           BigInt
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  payments SalePayment[]
  returns  SaleReturn[]

  @@index([deletedAt])
  @@index([date])
  @@index([customerId])
  @@map("sales")
}

enum PaymentType {
  PAYMENT
  REFUND
}

model SalePayment {
  id        String      @id @default(cuid())
  saleId    String
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    BigInt
  type      PaymentType @default(PAYMENT)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([saleId])
  @@index([saleId, type])
  @@index([deletedAt])
  @@map("sale_payments")
}

model SaleReturn {
  id           String    @id @default(cuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([saleId])
  @@index([deletedAt])
  @@map("sale_returns")
}

model Purchase {
  id              String    @id @default(cuid())
  date            DateTime
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partyName       String
  partyPhone      String?
  itemDescription String
  qty             Int
  rate            BigInt
  discount        BigInt    @default(0)
  total           BigInt
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  payments PurchasePayment[]
  returns  PurchaseReturn[]

  @@index([deletedAt])
  @@index([date])
  @@index([supplierId])
  @@map("purchases")
}

model PurchasePayment {
  id         String      @id @default(cuid())
  purchaseId String
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     BigInt
  type       PaymentType @default(PAYMENT)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([purchaseId])
  @@index([purchaseId, type])
  @@index([deletedAt])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id           String    @id @default(cuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date         DateTime
  qtyReturned  Int
  refundAmount BigInt
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([purchaseId])
  @@index([deletedAt])
  @@map("purchase_returns")
}
