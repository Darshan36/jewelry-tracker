// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (Prisma 7 architecture).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([name])
  @@map("suppliers")
}

enum EmployeeType {
  FIXED
  LABOUR
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  type          EmployeeType @default(LABOUR)
  monthlySalary BigInt?
  address       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@index([name])
  @@index([type])
  @@map("employees")
}
