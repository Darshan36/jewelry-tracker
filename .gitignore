# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Claude Code per-developer state (NOT the shared .mcp.json at project root)
.claude/settings.local.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local credentials — never commit
keys.txt
credentials.md
scripts/.test-user-insert.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated code — Prisma client (and any other future generators) outputs here
src/generated/

# Playwright walkthrough screenshots — verification artifacts, not source.
# Each walkthrough run regenerates them; keep the scripts but not the PNGs.
scripts/walkthrough*out/
scripts/_walkthrough*out/

# Underscore-prefixed scratch scripts (one-off tools, may contain creds or
# perform bucket/env-management). Naming convention: keep them locally,
# never commit.
scripts/_*.mjs
