# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database - Prisma uses these two
# DATABASE_URL = Transaction pooler (port 6543) for the app
#   Append ?pgbouncer=true&connection_limit=1 — required for Prisma against PgBouncer
#   Example: postgresql://postgres.<ref>:<url-encoded-pwd>@<host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL   = Session pooler (port 5432) for migrations
#   Leave query string empty — migrations need prepared statements which PgBouncer disables
#   Example: postgresql://postgres.<ref>:<url-encoded-pwd>@<host>:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Seed admin (used by `npx prisma db seed`)
#   SEED_ADMIN_EMAIL — lowercased and trimmed at seed time
#   SEED_ADMIN_PASSWORD — minimum 12 characters; bcrypt-hashed before storage
#   SEED_ADMIN_NAME — optional, defaults to "Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Cloudflare R2 (Phase 8 — bill file storage)
#   R2_ACCOUNT_ID — Cloudflare account ID (the 32-char hex prefix in R2_ENDPOINT_URL)
#   R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY — S3-compatible API token credentials.
#     Generated from Cloudflare dashboard → R2 → Manage R2 API Tokens.
#     The token value (cfat_…) is NOT used by the AWS SDK directly — the
#     SDK uses access key id + secret only.
#   R2_BUCKET_NAME — the bucket name (visible in the dashboard).
#   R2_ENDPOINT_URL — default-jurisdiction endpoint:
#     https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#     (do NOT include /<bucket> in this URL — the SDK appends bucket per-request)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
